{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/webhook/whatsapp", "destination": "/api/index?route=webhook/whatsapp" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "deployment_data/**"
    },
    "queues/audio_reports.py": {
      "maxDuration": 300
    }
  }
}
